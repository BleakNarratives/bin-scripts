"""ai — the one interface.

Interactive:      ai
Headless:         ai "fix this traceback"
For other agents: ai --json "..."        (machine-readable envelope)
Pick a model:     ai --model fast "..."
Read stdin:       cat log | ai --stdin "what failed"
Inspect:          ai --models | ai --health

All three modes go through bin/ai_lib.py, which goes through the single
rotating gateway. No provider keys are read here.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import ai_lib  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    cfg = ai_lib.load_config()
    headless = cfg.get("headless", {}) if isinstance(cfg.get("headless"), dict) else {}
    parser = argparse.ArgumentParser(
        prog="ai", description="One interface for every local model call.")
    parser.add_argument("prompt", nargs="*", help="prompt text (omit for interactive)")
    parser.add_argument("--headless", action="store_true",
                        help="force non-interactive (automatic when a prompt is given)")
    parser.add_argument("--json", action="store_true",
                        help="print a machine-readable envelope instead of plain text")
    parser.add_argument("--model", "-m", default=None,
                        help="preset name or provider::model (default: config default_model)")
    parser.add_argument("--system", "-s", default=headless.get("system"),
                        help="system prompt (defaults to config [headless].system)")
    parser.add_argument("--stdin", action="store_true",
                        help="append piped stdin to the prompt")
    parser.add_argument("--models", action="store_true", help="list gateway models")
    parser.add_argument("--health", action="store_true", help="show gateway health")
    return parser


def interactive(args: argparse.Namespace) -> int:
    """Minimal REPL. Ctrl-D or 'exit' to leave."""
    history: list[dict] = []
    model = args.model
    print("ai — interactive. model=%s. Ctrl-D to exit." % ai_lib.resolve_model(model))
    while True:
        try:
            line = input("> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not line:
            continue
        if line in ("exit", "quit"):
            return 0
        try:
            reply = ai_lib.ask(line, model=model, system=args.system, history=history)
        except RuntimeError as exc:
            print(f"[ai] {exc}", file=sys.stderr)
            continue
        print(reply)
        history.append({"role": "user", "content": line})
        history.append({"role": "assistant", "content": reply})


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)

    if args.health:
        # Ensure first: a bare probe reports stale downtime when the gateway is
        # simply not started yet, which is the normal state on a fresh shell.
        ai_lib.ensure_gateway()
        report = ai_lib.health()
        print(json.dumps(report, indent=2) if args.json else report)
        return 0

    if args.models:
        models = ai_lib.list_models()
        if args.json:
            print(json.dumps(models, indent=2))
        else:
            print("\n".join(models) if models else "no models (gateway down?)")
        return 0

    prompt = " ".join(args.prompt).strip()
    if args.stdin and not sys.stdin.isatty():
        piped = sys.stdin.read().strip()
        prompt = f"{prompt}\n\n{piped}".strip() if prompt else piped

    if not prompt:
        if sys.stdin.isatty():
            return interactive(args)
        prompt = sys.stdin.read().strip()
        if not prompt:
            build_parser().print_help()
            return 2

    started = __import__("time").time()
    try:
        reply = ai_lib.ask(prompt, model=args.model, system=args.system)
    except RuntimeError as exc:
        if args.json:
            print(json.dumps({"ok": False, "error": str(exc)}))
        else:
            print(f"[ai] {exc}", file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps({
            "ok": True,
            "model": ai_lib.resolve_model(args.model),
            "reply": reply,
            "seconds": round(__import__("time").time() - started, 2),
        }))
    else:
        print(reply)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
