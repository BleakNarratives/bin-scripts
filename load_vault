#!/bin/bash
# Load keys from vault files into current shell session
export GROQ_API_KEY=$(grep -h "gsk_" ~/RootBase/fleet_data/*.txt ~/opernrouter_api_vault_valet_concierge.txt 2>/dev/null | head -1 | tr -d ' \n')
export OPENROUTER_API_KEY=$(grep -h "sk-or-v1" ~/opernrouter_api_vault_valet_concierge.txt 2>/dev/null | head -1 | tr -d ' \n')
echo "[VAULT] Keys loaded: GROQ=$(echo $GROQ_API_KEY | cut -c1-8)... OR=$(echo $OPENROUTER_API_KEY | cut -c1-12)..."
