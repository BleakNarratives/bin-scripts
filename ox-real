  ox --model openai/gpt-oss-120b "task" # Override model
  ox --groq --model openai/gpt-oss-120b "x" # Use Groq provider
  ox --json "return schema as JSON"    # Structured output for agents
  ox --persona mikey "prompt"          # Inject MikeySwarm persona
