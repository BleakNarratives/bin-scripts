#!/usr/bin/env bash
# Concierge Vault wrapper for Code Judo Dojo.
# Sources the REAL vault loader (~/bin/vault-env -> ~/.concierge/vault.json)
# so the OpenRouter key POOL reaches the Dojo for rotation on 429/402/403.
# Keys live only in this process env — never persisted, never naked.

if [ -f "$HOME/bin/vault-env" ]; then
    . "$HOME/bin/vault-env"
elif [ -f "$HOME/.vault-env" ]; then
    . "$HOME/.vault-env"
fi

exec python3 "$HOME/.codejudo/codejudo.py" "$@"
